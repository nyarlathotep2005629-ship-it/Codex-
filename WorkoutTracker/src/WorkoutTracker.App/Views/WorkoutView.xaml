<UserControl x:Class="WorkoutTracker.App.Views.WorkoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             PreviewKeyDown="OnPreviewKeyDown"
             PreviewGotKeyboardFocus="OnPreviewGotKeyboardFocus">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="ActiveOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="StartOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <StackPanel Style="{StaticResource StartOnly}" MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="ワークアウトを開始" Style="{StaticResource PageTitleStyle}" TextAlignment="Center" />
            <Button Content="メニューなしで開始" Click="StartWithoutMenu_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,20" automation:AutomationProperties.Name="メニューなしでワークアウトを開始" />
            <TextBlock Text="保存済みメニュー" Style="{StaticResource SectionTitleStyle}" Margin="0,8" />
            <ItemsControl ItemsSource="{Binding AvailableMenus}">
                <ItemsControl.ItemTemplate><DataTemplate><Button Click="StartMenu_Click" Tag="{Binding Id}" Margin="0,4" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding ExerciseCount, StringFormat={}{0}種目}" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <DockPanel Style="{StaticResource ActiveOnly}">
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                    <TextBox Text="{Binding WorkoutName, UpdateSourceTrigger=PropertyChanged}" FontSize="25" FontWeight="SemiBold" BorderThickness="0" automation:AutomationProperties.Name="ワークアウト名" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox Text="{Binding WorkoutDate, UpdateSourceTrigger=LostFocus}" Width="120" automation:AutomationProperties.Name="ワークアウト日" />
                            <TextBlock Text="下書き" Margin="14,3" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SaveStateText}" Margin="14,3" automation:AutomationProperties.Name="保存状態" />
                            <TextBlock Text="{Binding TotalSets, StringFormat=セット数: {0}}" Margin="14,3" />
                            <TextBlock Text="{Binding TotalVolume, StringFormat=ボリューム: {0:N2} kg}" Margin="14,3" />
                            <Button Content="再試行" Command="{Binding RetrySaveCommand}" Margin="8,0" Padding="8,2"><Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SaveState}" Value="Failed"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="ワークアウトを破棄" Click="Discard_Click" Style="{StaticResource DangerButtonStyle}" Margin="4" automation:AutomationProperties.Name="ワークアウトを破棄" />
                        <Button Content="ワークアウトを完了" Click="Finish_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="4" automation:AutomationProperties.Name="ワークアウトを完了" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding LastOperationError}" Foreground="{DynamicResource ErrorBrush}" Margin="0,8" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Assertive" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Exercises}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="種目を削除" Click="RemoveExercise_Click" Style="{StaticResource QuietButtonStyle}" Foreground="{DynamicResource DangerBrush}" automation:AutomationProperties.Name="種目を削除" />
                                            <StackPanel><TextBlock Text="{Binding ExerciseName}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding PrimaryMuscleName}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                                        </DockPanel>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10" Margin="0,10"><StackPanel><TextBlock Text="前回の記録" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding PreviousPerformance.Sets}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="セット "/><Run Text="{Binding SetNumber}"/><Run Text=": "/><Run Text="{Binding WeightKg}"/><Run Text=" kg × "/><Run Text="{Binding Reps}"/><Run Text=" 回"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="重量 (kg)" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="回数" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="RPE" FontWeight="SemiBold"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Sets}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding SetNumber}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1"><TextBox x:Name="WeightInput" Text="{Binding WeightKg, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" PreviewKeyDown="SetInput_PreviewKeyDown" Tag="Weight" Margin="2" automation:AutomationProperties.Name="重量 kg"/><TextBlock Text="{Binding SuggestedWeightKg, StringFormat=候補: {0} kg}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding WeightError}" Style="{StaticResource InlineValidationStyle}"/></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBox x:Name="RepsInput" Text="{Binding Reps, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" PreviewKeyDown="SetInput_PreviewKeyDown" Tag="Reps" Margin="2" automation:AutomationProperties.Name="回数"/><TextBlock Text="{Binding SuggestedReps, StringFormat=候補: {0} 回}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding RepsError}" Style="{StaticResource InlineValidationStyle}"/></StackPanel>
                                                    <StackPanel Grid.Column="3"><TextBox x:Name="RpeInput" Text="{Binding Rpe, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" PreviewKeyDown="SetInput_PreviewKeyDown" Tag="Rpe" Margin="2" automation:AutomationProperties.Name="RPE"/><TextBlock Text="{Binding RpeError}" Style="{StaticResource InlineValidationStyle}"/></StackPanel>
                                                    <Button Grid.Column="4" Content="削除" Command="{Binding DataContext.RemoveSetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="8,3" Margin="4" automation:AutomationProperties.Name="セットを削除" />
                                                </Grid>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button x:Name="AddSetButton" Content="＋ セットを追加" Command="{Binding AddSetCommand}" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8" automation:AutomationProperties.Name="セットを追加" />
                                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="50" automation:AutomationProperties.Name="種目メモ" />
                                        <TextBlock Text="{Binding NoteError}" Foreground="{DynamicResource ErrorBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding CurrentVolume, StringFormat=ボリューム: {0:N2} kg}" Margin="0,8" />
                                        <TextBlock Text="{Binding EstimatedOneRepMax, StringFormat=推定1RM: {0:N1} kg}" Margin="0,0,0,8" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource CardStyle}" Padding="12">
                        <StackPanel Orientation="Horizontal"><ComboBox ItemsSource="{Binding AvailableExercises}" SelectedItem="{Binding SelectedExercise}" DisplayMemberPath="ExerciseName" Width="280" automation:AutomationProperties.Name="追加する種目"/><Button Content="種目を追加" Command="{Binding AddExerciseCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0"/></StackPanel>
                    </Border>
                    <TextBox Text="{Binding WorkoutNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" Margin="0,14" automation:AutomationProperties.Name="ワークアウトメモ" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
