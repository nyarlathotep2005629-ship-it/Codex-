<UserControl x:Class="WorkoutTracker.App.Views.MasterDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WorkoutTracker.App.ViewModels">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/></UserControl.Resources>
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="メニュー・種目管理" Style="{StaticResource PageTitleStyle}"/>
        <Border Grid.Row="1" Style="{StaticResource ErrorStateCardStyle}" Margin="0,0,0,12" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"><DockPanel><Button DockPanel.Dock="Right" Content="再試行" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding OperationCanRetry, Converter={StaticResource BoolToVisibility}}" Margin="12,0,0,0"/><TextBlock Text="{Binding OperationError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>

        <TabControl x:Name="MasterTabs" Grid.Row="2">
            <TabItem Header="メニュー">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <DockPanel><Button DockPanel.Dock="Top" Content="＋ 新しいメニュー" Command="{Binding NewMenuCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="12"/><ListBox ItemsSource="{Binding Menus}" SelectedItem="{Binding SelectedMenu}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:MenuMasterItemViewModel}"><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding ExerciseSummary}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/><TextBlock Margin="0,5,0,8"><Run Text="種目 "/><Run Text="{Binding ExerciseCount, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="件  ・  予定 "/><Run Text="{Binding PlannedSetCount, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="セット"/></TextBlock><WrapPanel><Button Content="開始" Tag="{Binding}" Click="StartMenu_Click" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="編集" Tag="{Binding}" Click="EditMenu_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"/><Button Content="複製" Tag="{Binding}" Click="DuplicateMenu_Click" Style="{StaticResource QuietButtonStyle}" Margin="4,0,0,0"/><Button Content="削除" Tag="{Binding}" Click="DeleteMenu_Click" Style="{StaticResource QuietButtonStyle}" Foreground="{DynamicResource DangerBrush}" Margin="4,0,0,0"/></WrapPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
                    </Border>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource CardStyle}"><StackPanel>
                            <TextBlock Text="{Binding MenuEditorTitle}" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="メニュー名" Style="{StaticResource CardTitleStyle}" Margin="0,4,0,4"/><TextBox Text="{Binding MenuName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/><TextBlock Text="{Binding MenuNameError}" Style="{StaticResource InlineValidationStyle}"/>
                            <TextBlock Text="説明" Style="{StaticResource CardTitleStyle}" Margin="0,16,0,4"/><TextBox Text="{Binding MenuDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AcceptsReturn="True" Height="72"/>
                            <TextBlock Text="登録種目" Style="{StaticResource SectionTitleStyle}" Margin="0,22,0,8"/>
                            <TextBlock Text="種目名または部位で検索" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/><TextBox Text="{Binding ExerciseSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="種目名または部位で検索" Margin="0,0,0,8"/>
                            <DockPanel><Button DockPanel.Dock="Right" Content="新しい種目を作成" Click="CreateExerciseFromMenu_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="種目を追加" Command="{Binding AddMenuExerciseCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding ActiveExercises}" SelectedItem="{Binding ExerciseToAdd}" DisplayMemberPath="Name"/></DockPanel>
                            <TextBlock Text="ドラッグ、または上下ボタンで順番を変更できます。" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,5"/>
                            <ListBox x:Name="MenuExerciseList" ItemsSource="{Binding MenuExercises}" AllowDrop="True" PreviewMouseLeftButtonDown="MenuExerciseList_PreviewMouseLeftButtonDown" PreviewMouseMove="MenuExerciseList_PreviewMouseMove" Drop="MenuExerciseList_Drop" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:MenuExerciseEditorViewModel}"><Border Style="{StaticResource SubtleCardStyle}" Margin="0,3" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="≡" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ExerciseName}" VerticalAlignment="Center" FontWeight="SemiBold"/><StackPanel Grid.Column="2" Margin="8,0"><TextBlock Text="予定セット数" Style="{StaticResource CaptionTextStyle}"/><TextBox Text="{Binding DefaultSetCount, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding DefaultSetCountError}" Style="{StaticResource InlineValidationStyle}"/></StackPanel><StackPanel Grid.Column="3" Margin="8,0"><TextBlock Text="メモ" Style="{StaticResource CaptionTextStyle}"/><TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000"/></StackPanel><StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="上へ" Command="{Binding DataContext.MoveMenuExerciseUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource QuietButtonStyle}"/><Button Content="下へ" Command="{Binding DataContext.MoveMenuExerciseDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource QuietButtonStyle}"/><Button Content="削除" Command="{Binding DataContext.RemoveMenuExerciseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource QuietButtonStyle}" Foreground="{DynamicResource DangerBrush}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                            <TextBlock Text="{Binding MenuExerciseError}" Style="{StaticResource InlineValidationStyle}"/>
                            <Button Content="メニューを保存" Command="{Binding SaveMenuCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,18,0,0"/>
                        </StackPanel></Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="種目">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="12"><Button Content="＋ 新しい種目" Command="{Binding NewExerciseCommand}" Style="{StaticResource PrimaryButtonStyle}"/><TextBox Text="{Binding ExerciseSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="種目名または部位で検索" Margin="0,10,0,0"/></StackPanel><ListBox ItemsSource="{Binding FilteredExercises}" SelectedItem="{Binding SelectedExercise}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:ExerciseMasterItemViewModel}"><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding PrimaryMuscleName}" Style="{StaticResource CaptionTextStyle}"/><TextBlock Text="{Binding SecondaryMuscles}" Style="{StaticResource CaptionTextStyle}"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="8,3" VerticalAlignment="Top"><TextBlock Text="{Binding StateLabel}" Style="{StaticResource CaptionTextStyle}"/></Border></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><Border Style="{StaticResource CardStyle}"><StackPanel MinWidth="430">
                        <TextBlock Text="{Binding ExerciseEditorTitle}" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="種目名" Style="{StaticResource CardTitleStyle}" Margin="0,4,0,4"/><TextBox Text="{Binding ExerciseName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/><TextBlock Text="{Binding ExerciseNameError}" Style="{StaticResource InlineValidationStyle}"/>
                        <TextBlock Text="メイン部位" Style="{StaticResource CardTitleStyle}" Margin="0,16,0,4"/><ComboBox ItemsSource="{Binding MuscleGroups}" SelectedItem="{Binding ExercisePrimaryMuscle}" DisplayMemberPath="Name"/><TextBlock Text="{Binding ExercisePrimaryMuscleError}" Style="{StaticResource InlineValidationStyle}"/>
                        <TextBlock Text="サブ部位" Style="{StaticResource CardTitleStyle}" Margin="0,16,0,4"/><ItemsControl ItemsSource="{Binding SecondaryMuscles}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,3,18,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="メモ" Style="{StaticResource CardTitleStyle}" Margin="0,16,0,4"/><TextBox Text="{Binding ExerciseNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AcceptsReturn="True" Height="86"/>
                        <CheckBox Content="ワークアウトの種目選択に表示する" IsChecked="{Binding ExerciseIsActive}" Margin="0,16,0,0"/>
                        <DockPanel Margin="0,20,0,0"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Content="種目を保存" Command="{Binding SaveExerciseCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="表示状態を切り替え" Click="ToggleExercise_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="未使用の種目を削除" Click="DeleteExercise_Click" Style="{StaticResource DangerButtonStyle}"/></DockPanel>
                        <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0"><TextBlock Text="使用済み、またはメニューで使用中の種目は削除できません。非表示にすると過去の記録を保持できます。" TextWrapping="Wrap"/></Border>
                    </StackPanel></Border></ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="部位">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="0"><DockPanel><Button DockPanel.Dock="Top" Content="＋ 新しい部位" Command="{Binding NewMuscleGroupCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="12"/><ListBox ItemsSource="{Binding MuscleGroups}" SelectedItem="{Binding SelectedMuscleGroup}" DisplayMemberPath="Name" BorderThickness="0"/></DockPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top"><StackPanel><TextBlock Text="{Binding MuscleEditorTitle}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="部位名" Style="{StaticResource CardTitleStyle}" Margin="0,4,0,4"/><TextBox Text="{Binding MuscleName, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/><TextBlock Text="{Binding MuscleNameError}" Style="{StaticResource InlineValidationStyle}"/><DockPanel Margin="0,18,0,0"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Content="保存" Command="{Binding SaveMuscleGroupCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="上へ" Command="{Binding MoveMuscleUpCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button Content="下へ" Command="{Binding MoveMuscleDownCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="部位を削除" Click="DeleteMuscleGroup_Click" Style="{StaticResource DangerButtonStyle}"/></DockPanel><TextBlock Text="現在の種目でメイン部位・サブ部位として使用中の場合は削除できません。" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
