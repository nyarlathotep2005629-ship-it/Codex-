<UserControl x:Class="WorkoutTracker.App.Views.StatisticsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WorkoutTracker.App.Views">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="統計" Style="{StaticResource PageTitleStyle}"/>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16"><WrapPanel>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="種目" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding ExerciseOptions}" SelectedItem="{Binding SelectedExercise}" DisplayMemberPath="Name" MinWidth="240"/></StackPanel>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="期間" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" MinWidth="140"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource UiDisplayTextConverter}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
            <StackPanel><TextBlock Text="指標" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding MetricOptions}" SelectedItem="{Binding SelectedMetric}" MinWidth="180"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource UiDisplayTextConverter}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
        </WrapPanel></Border>
        <Grid Grid.Row="2" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="現在の1RM" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="{Binding CurrentOneRepMaxText}" Style="{StaticResource PrimaryMetricStyle}"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="2,0,4,0"><StackPanel><TextBlock Text="ベスト1RM" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="{Binding BestOneRepMaxText}" Style="{StaticResource PrimaryMetricStyle}"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0,2,0"><StackPanel><TextBlock Text="最大重量" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="{Binding MaxWeightText}" Style="{StaticResource PrimaryMetricStyle}"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="6,0,0,0"><StackPanel><TextBlock Text="ワークアウト回数" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="{Binding WorkoutCountText}" Style="{StaticResource PrimaryMetricStyle}"/><TextBlock Text="回" Style="{StaticResource CaptionTextStyle}"/></StackPanel></Border>
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedMetric, Converter={StaticResource UiDisplayTextConverter}}" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text=" の推移" Style="{StaticResource SectionTitleStyle}"/></StackPanel><views:AnalyticsChartView Grid.Row="1" Series="{Binding Series}"/></Grid></Border>
        <TextBlock Grid.RowSpan="4" Text="読み込み中…" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Border Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource EmptyStateCardStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="分析できるデータがまだありません。" FontSize="19" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="ワークアウトを記録すると、ここに進捗グラフが表示されます。" Style="{StaticResource CaptionTextStyle}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource ErrorStateCardStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PageState}" Value="Error"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="統計を読み込めませんでした。" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,6,0,12"/><Button Content="再試行" Command="{Binding RetryCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/></StackPanel></Border>
    </Grid>
</UserControl>
