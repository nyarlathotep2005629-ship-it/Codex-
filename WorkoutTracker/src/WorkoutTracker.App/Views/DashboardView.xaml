<UserControl x:Class="WorkoutTracker.App.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WorkoutTracker.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="FrequencyItemsStyle" TargetType="ItemsControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasFrequencyData}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NoFrequencyStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasFrequencyData}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource PagePadding}">
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="ダッシュボード" Style="{StaticResource PageTitleStyle}" Margin="0"/><TextBlock Text="{Binding PeriodLabel}" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="表示期間" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" MinWidth="150"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource UiDisplayTextConverter}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="グラフに表示する種目" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="最大4種目まで選択できます。" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,8"/><ItemsControl ItemsSource="{Binding ExerciseOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,4,20,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>

                <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="ワークアウト回数" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="{Binding Summary.WorkoutCount}" Style="{StaticResource PrimaryMetricStyle}"/><TextBlock Text="回" Style="{StaticResource CaptionTextStyle}"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0"><StackPanel><TextBlock Text="総ボリューム" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="{Binding Summary.TotalVolume, StringFormat={}{0:0.##}}" Style="{StaticResource PrimaryMetricStyle}"/><TextBlock Text="kg" Style="{StaticResource CaptionTextStyle}"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0"><StackPanel><TextBlock Text="総セット数" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="{Binding Summary.TotalSets}" Style="{StaticResource PrimaryMetricStyle}"/><TextBlock Text="セット" Style="{StaticResource CaptionTextStyle}"/></StackPanel></Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20"><StackPanel><TextBlock Text="推定1RMの推移" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="種目ごとに独立したスケールで表示します。" Style="{StaticResource CaptionTextStyle}" Margin="0,-8,0,12"/><ItemsControl ItemsSource="{Binding OneRepMaxSeries}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SubtleCardStyle}" Width="460" Margin="0,0,12,12" Padding="10"><views:AnalyticsChartView Series="{Binding}" Height="230"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>

                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="ワークアウト頻度" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="月曜開始・記録のある直近8週" Style="{StaticResource CaptionTextStyle}" Margin="0,-8,0,10"/><ItemsControl ItemsSource="{Binding CompactFrequency}" Style="{StaticResource FrequencyItemsStyle}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="{Binding BucketStart, StringFormat={}{0:MM/dd}}" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding WorkoutCount}" Maximum="{Binding DataContext.MaxFrequencyWorkoutCount, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="10" Margin="8,0"/><TextBlock Grid.Column="2" Text="{Binding WorkoutCount, StringFormat={}{0}回}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="この期間にワークアウト記録はありません。" Style="{StaticResource NoFrequencyStyle}"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0"><StackPanel><TextBlock Text="部位別ボリューム" Style="{StaticResource SectionTitleStyle}"/><ItemsControl ItemsSource="{Binding MuscleVolumes}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1"><Run Text="{Binding Volume, StringFormat={}{0:0.##} kg}"/><Run Text="  "/><Run Text="{Binding Ratio, StringFormat={}{0:P0}}" Foreground="{DynamicResource TextSecondaryBrush}"/></TextBlock></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0"><StackPanel><TextBlock Text="最近のワークアウト" Style="{StaticResource SectionTitleStyle}"/><ItemsControl ItemsSource="{Binding RecentWorkouts}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" Style="{StaticResource CaptionTextStyle}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Volume, StringFormat={}{0:0.##} kg}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0"><StackPanel><TextBlock Text="前期間との比較" Style="{StaticResource SectionTitleStyle}"/><ItemsControl ItemsSource="{Binding Comparisons}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,10,0" Padding="12"><StackPanel><TextBlock Text="{Binding Metric, Converter={StaticResource UiDisplayTextConverter}}" Style="{StaticResource CardTitleStyle}"/><TextBlock><Run Text="現在 "/><Run Text="{Binding CurrentValue, StringFormat={}{0:0.##}}" FontWeight="SemiBold"/><Run Text="  /  前期間 "/><Run Text="{Binding PreviousValue, StringFormat={}{0:0.##}}"/></TextBlock></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Text="読み込み中…" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        <Border Style="{StaticResource EmptyStateCardStyle}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="まだワークアウトがありません。" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="最初のワークアウトを記録すると、ここに履歴や分析が表示されます。" Style="{StaticResource BodyTextStyle}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,18"/><Button Content="ワークアウトを開始" Command="{Binding StartWorkoutCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center"/></StackPanel></Border>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource ErrorStateCardStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PageState}" Value="Error"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="ダッシュボードを読み込めませんでした。" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,6,0,12"/><Button Content="再試行" Command="{Binding RetryCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/></StackPanel></Border>
    </Grid>
</UserControl>
