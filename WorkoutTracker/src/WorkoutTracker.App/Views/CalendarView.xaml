<UserControl x:Class="WorkoutTracker.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WorkoutTracker.App.Views">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/></UserControl.Resources>
    <Grid Margin="{DynamicResource PagePadding}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Left" Content="◀ 前の月" Command="{Binding PreviousMonthCommand}" Style="{DynamicResource SecondaryButtonStyle}"/><Button DockPanel.Dock="Right" Content="次の月 ▶" Command="{Binding NextMonthCommand}" Style="{DynamicResource SecondaryButtonStyle}"/><TextBlock Text="{Binding MonthTitle}" Style="{DynamicResource PageTitleStyle}" HorizontalAlignment="Center" Margin="0"/></DockPanel>
            <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,4"><TextBlock Text="日" HorizontalAlignment="Center" Style="{DynamicResource CaptionTextStyle}"/><TextBlock Text="月" HorizontalAlignment="Center" Style="{DynamicResource CaptionTextStyle}"/><TextBlock Text="火" HorizontalAlignment="Center" Style="{DynamicResource CaptionTextStyle}"/><TextBlock Text="水" HorizontalAlignment="Center" Style="{DynamicResource CaptionTextStyle}"/><TextBlock Text="木" HorizontalAlignment="Center" Style="{DynamicResource CaptionTextStyle}"/><TextBlock Text="金" HorizontalAlignment="Center" Style="{DynamicResource CaptionTextStyle}"/><TextBlock Text="土" HorizontalAlignment="Center" Style="{DynamicResource CaptionTextStyle}"/></UniformGrid>
            <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10,6" HorizontalAlignment="Center" Margin="0,0,0,6" Visibility="{Binding IsMonthEmpty, Converter={StaticResource BoolToVisibility}}"><TextBlock x:Name="MonthEmptyState" Grid.Row="2" Text="この月には完了したワークアウトがありません。" Style="{DynamicResource CaptionTextStyle}"/></Border>
            <Border Grid.Row="3" Style="{DynamicResource CardStyle}" Padding="6"><Grid x:Name="CalendarGrid" Grid.Row="3"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Cells}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MinHeight="72" Margin="2" Padding="6" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Grid><TextBlock Text="{Binding DayLabel}" HorizontalAlignment="Left" VerticalAlignment="Top"/><Border Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding HasWorkouts, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding Marker}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/></Border></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="読み込み中…" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/></Grid></Border>
            <Border Grid.Row="4" Style="{DynamicResource CardStyle}" Margin="0,12,0,0"><Grid><DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding SelectedDayTitle}" Style="{DynamicResource SectionTitleStyle}"/><ListBox ItemsSource="{Binding SelectedWorkouts}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7"><DockPanel><Button DockPanel.Dock="Right" Content="詳細を見る" Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}"/><StackPanel><TextBlock Text="{Binding Name, TargetNullValue=ワークアウト}" FontWeight="SemiBold"/><TextBlock Style="{DynamicResource CaptionTextStyle}"><Run Text="セット数: "/><Run Text="{Binding TotalSets}"/><Run Text="  ボリューム: "/><Run Text="{Binding TotalVolume, StringFormat={}{0:N2} kg}"/></TextBlock></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel><TextBlock Text="選択した日にはワークアウトがありません。" Style="{DynamicResource CaptionTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsSelectedDayEmpty, Converter={StaticResource BoolToVisibility}}"/></Grid></Border>
        </Grid>
        <Border Width="420" Style="{DynamicResource CardStyle}" Margin="16,-8,-8,-8" HorizontalAlignment="Right" Panel.ZIndex="10" Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVisibility}}"><DockPanel><Button DockPanel.Dock="Top" Content="詳細を閉じる" Command="{Binding CloseDetailCommand}" Style="{DynamicResource QuietButtonStyle}" HorizontalAlignment="Right"/><views:WorkoutDetailView DataContext="{Binding SelectedDetail}"/></DockPanel></Border>
    </Grid>
</UserControl>
