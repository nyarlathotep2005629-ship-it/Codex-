{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-x64-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "vs2026-x64-debug",
      "inherits": "vs2026-x64-base",
      "binaryDir": "${sourceDir}/build/vs2026-x64-debug",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug"
      }
    },
    {
      "name": "vs2026-x64-release",
      "inherits": "vs2026-x64-base",
      "binaryDir": "${sourceDir}/build/vs2026-x64-release",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-x64-debug",
      "configurePreset": "vs2026-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-x64-release",
      "configurePreset": "vs2026-x64-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "vs2026-x64-debug",
      "configurePreset": "vs2026-x64-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vs2026-x64-release",
      "configurePreset": "vs2026-x64-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

